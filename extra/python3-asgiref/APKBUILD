# Alpine-Contributor: Kaarle Ritvanen <kunkku@alpinelinux.org>
# Alpine-Maintainer: Kaarle Ritvanen <kunkku@alpinelinux.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-asgiref
pkgver=3.9.1
pkgrel=0
pkgdesc="ASGI specs, helper code, and adapters"
url="https://github.com/django/asgiref/"
arch="noarch"
license="BSD-3-Clause"
makedepends="python3-gpep517 python3-setuptools python3-wheel"
checkdepends="python3-pytest python3-pytest-asyncio"
source="https://files.pythonhosted.org/packages/source/a/asgiref/asgiref-$pkgver.tar.gz"
builddir="$srcdir/asgiref-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
bc1a947dc7026fbd95970c71e699462856752b48024e2adf3ab5298dd8fb3fcee2e02a95eb97c5e8fe51ba77763b07f8e2922656ecac5b4205e03054663f9bbc  asgiref-3.9.1.tar.gz
"
