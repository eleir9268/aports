# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=taisei
pkgver=1.4.6
pkgrel=0
pkgdesc="Free Touhou Project fangame"
url="https://github.com/taisei-project/taisei"
arch="all"
license="MIT AND CC-BY-4.0 AND LicenseRef-scancode-public-domain"
depends="cglm freetype libcrypto3 libpng libunibreak libwebp sdl3 spirv-cross
    zlib zstd"
makedepends="meson cglm-dev freetype-dev libpng-dev libunibreak-dev libwebp-dev
    spirv-cross-dev openssl-dev sdl3-dev zlib-dev zstd-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/taisei-project/taisei/archive/refs/tags/v$pkgver.tar.gz
    fix-gles.patch"
builddir="$srcdir/$pkgname-$pkgver"

build() {
    meson setup build \
        --buildtype=release \
        --default-library=shared \
        -Dprefix=/usr \
        -Db_lto=false \
        -Dr_gles30=enabled
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

check() {
    meson test --print-errorlogs -C build
}

