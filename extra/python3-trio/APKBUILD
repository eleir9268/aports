# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=python3-trio
pkgver=0.33.0
pkgrel=0
pkgdesc="A friendly Python library for async concurrency and I/O"
url="https://trio.readthedocs.io/"
arch="noarch"
license="MIT OR Apache-2.0"
depends="
    python3-attrs
    python3-async_generator
    python3-idna
    python3-cffi
    python3-outcome
    python3-sniffio
    python3-sortedcontainers
    "
makedepends="
    python3-gpep517
    python3-setuptools
    python3-wheel
    "
checkdepends="
    python3-astor
    python3-pytest
    "
source="https://pypi.python.org/packages/source/t/trio/trio-$pkgver.tar.gz
    qnx-epoll.patch
    "
builddir="$srcdir/trio-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest \
        --pyargs trio --skip-optional-imports \
        -v -m "not redistributors_should_skip"
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
edd4bd9cdda4ca68a251d0cf6841b549448fcdc0816c7ec8347966a8fbb4971e36134799d06c949150b8de2f1233c0de7becd600d29ba0e2c5a6a6ab03e7697e  trio-0.33.0.tar.gz
c9315c493dac598dc55dfc894f5e978675a4cbce81ca2222cb6879225f5d1f002eb16f863f3f623faf96ad1619324103042d28ff2d7917d2044ad71a2ce7929c  qnx-epoll.patch
"
