# Alpine-Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=sdl3
_pkgname=SDL
pkgver=3.4.18
pkgrel=0
pkgdesc="Simple Directmedia Layer"
url="https://libsdl.org/"
arch="all"
license="Zlib"
depends="
     qnx-alsa
     qnx-screen
     qnx-egl
     qnx-gles
     wayland
     libxkbcommon"
makedepends="
     qnx-alsa-dev
     qnx-screen-dev
     egl-headers
     gles-headers
     wayland-dev
     wayland-protocols
     qnx-usb-static
     qnx-usb-dev
     libxkbcommon-static
     libxkbcommon-dev
     autoconf
     clang
     cmake
     ninja"
subpackages="$pkgname-dev $pkgname-dbg $pkgname-doc"
_git_rev=0
source="$pkgname-$pkgver-r$_git_rev.tar.gz::https://www.github.com/eleir9268/$_pkgname/archive/refs/tags/qnx-release-$pkgver-r$_git_rev.tar.gz"
builddir="$srcdir/$_pkgname-qnx-release-$pkgver-r$_git_rev"

build() {
    export CPPFLAGS="${CPPFLAGS} -D_QNX_SOURCE -Wno-error=incompatible-function-pointer-types"
    cmake -B build -G Ninja \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_ASM_COMPILER=clang \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DSDL_SHARED=ON \
        -DSDL_STATIC=ON \
        -DSDL_X11=0 \
        -DSDL_WAYLAND=1 \
        -DSDL_VIDEO=1 \
        -DSDL_AUDIO=1 \
        -DSDL_JOYSTICK=1 \
        -DSDL_TESTS=1
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build-static
    DESTDIR="$pkgdir" cmake --install build-shared
}

check() {
    # Disable SDL_strtod() failures
    ctest --test-dir build-shared -E "(testautomation|testautomation-no-simd)"
}

dev() {
    default_dev
    provides="$pkgname-static=$pkgver-r$pkgrel"
}

sha512sums="
d384667334ee9199f8876b95d57ecbafa975d645778ae6b6a28e6dd9a6a7537d97c44e5c74735aeb619f716bac1769ea440102bc89f1d7ae35081a667c078f8c  sdl3-3.4.18-r0.tar.gz
"
